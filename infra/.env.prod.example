# Copy to .env for production deployment and replace every placeholder.
POSTGRES_USER=hefin
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=hefin

# Generate with: openssl rand -hex 32
SECRET_KEY=replace-with-a-long-random-secret

MINIO_ROOT_USER=hefin
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password

# Public browser URL for the FastAPI service.
NEXT_PUBLIC_API_URL=https://api.example.com
ALLOWED_ORIGINS=https://app.example.com

# At least one model provider must be configured for AI responses.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

BACKEND_PORT=8000
FRONTEND_PORT=3000
